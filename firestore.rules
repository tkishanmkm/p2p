rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Robust admin check: User must have a document in the 'admins' collection
      // with a 'role' field set to 'admin'. This is more secure than just checking for existence.
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isUserActive() {
      // A user is active if they are not banned or on hold.
      // This is used to restrict actions like creating ads or starting trades.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.isBanned == false && userDoc.isOnHold == false;
    }
    
    function isTradeParticipant(tradeId) {
      // Checks if the requesting user is either the buyer or the seller in a trade.
      let trade = get(/databases/$(database)/documents/trades/$(tradeId)).data;
      return trade.buyerId == request.auth.uid || trade.sellerId == request.auth.uid;
    }

    // --- Root-level Security ---
    // Explicitly block all reads and writes at the root level.
    // This forces all access to be defined on specific collection paths.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Admins Collection ---
    // Admins can read their own role document to verify their status.
    // They can also create their own role document upon first-time login.
    match /admins/{adminId} {
        allow get, create: if isOwner(adminId);
        // Nobody can list, update, or delete admin role documents.
        allow list, update, delete: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin(); 
      allow list: if isAdmin(); // Only admins can list all users.
      allow create: if isOwner(userId); // A user can create their own profile document.
      allow update: if isOwner(userId) || isAdmin(); // A user can update their own profile, or an admin can.
      allow delete: if isAdmin(); // Only admins can delete users.

      // User subcollections are private to the user, but manageable by admins.
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /deposits/{depositId} {
        // A user must be active to create a deposit request.
        allow create: if isOwner(userId) && isUserActive();
        allow read, update, delete: if isOwner(userId) || isAdmin();
      }
       match /withdrawals/{withdrawalId} {
        // Withdrawals are allowed even if banned/on hold, so no isUserActive() check.
        allow read, write: if isOwner(userId) || isAdmin();
      }
       match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- P2P Ads Collection ---
    match /p2p_ads/{adId} {
        allow get, list: if true; // Ads are public to everyone.
        allow create: if isSignedIn() && isUserActive();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin(); // Only the ad owner or an admin can modify/delete.
    }

    // --- Trades Collection ---
    match /trades/{tradeId} {
        // Only trade participants and admins can get or update a trade.
        allow get, update: if isTradeParticipant(tradeId) || isAdmin();
        allow create: if isSignedIn() && isUserActive();
        allow list: if isAdmin(); // Only admins can list all trades.
        allow delete: if false; // Trades should not be deleted; they should be 'cancelled'.

        // Subcollections are only accessible to trade participants and admins.
        match /messages/{messageId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
        match /disputes/{disputeId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
        match /feedback/{feedbackId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
    }

    // --- Support Tickets Collection ---
    match /support_tickets/{ticketId} {
        allow create: if isSignedIn(); // Any signed-in user can create a ticket.
        allow read, list, update: if isAdmin(); // Only admins can manage tickets.
        allow delete: if false; // Tickets are archived, not deleted.
    }
    
    // --- Globally Readable Platform Configuration ---
    match /payment_methods/{paymentMethodId} {
        allow get, list: if true;
        allow write: if false;
    }
    
    // --- Admin-Only Collections & Configuration ---
    match /crypto_deposit_addresses/{addressId} {
        allow read, write: if isAdmin(); // Only admins can manage these.
    }

    match /admin_logs/{logId} {
        allow read, write: if isAdmin();
    }

    // --- Collection Group Rules for Admin Panel ---
    // These rules are essential for the admin dashboard to query across all users.
    // They override the more specific /users/{userId}/... rules ONLY for admins.
    match /{path=**}/deposits/{depositId} {
        allow list, get: if isAdmin();
    }
    match /{path=**}/withdrawals/{withdrawalId} {
        allow list, get: if isAdmin();
    }
    match /{path=**}/disputes/{disputeId} {
        allow list, get: if isAdmin();
    }
  }
}
