rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isUserActive() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.isBanned == false && userDoc.isOnHold == false;
    }
    
    function isTradeParticipant(tradeId) {
      let trade = get(/databases/$(database)/documents/trades/$(tradeId)).data;
      return trade.buyerId == request.auth.uid || trade.sellerId == request.auth.uid;
    }

    // --- Root-level Security ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Config Collection ---
    match /_config/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
        allow get, create: if isOwner(adminId);
        allow list, update, delete: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin(); 
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // User subcollections are private to the user, but manageable by admins.
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /withdrawals/{withdrawalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // --- Deposits (Top-Level Collection) ---
    match /deposits/{depositId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      // Users can list their own deposits (with a 'where' clause), and admins can list all deposits.
      // This is secure because Firestore checks the 'get' rule for each document returned by a 'list' query.
      allow list: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      // Admins can update any deposit. Users can update their own (e.g., to add a txId).
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- P2P Ads Collection ---
    match /p2p_ads/{adId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isUserActive();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // --- Trades Collection ---
    match /trades/{tradeId} {
        // Trade participants and admins can get a single trade document.
        allow get: if isTradeParticipant(tradeId) || isAdmin();
        // Any signed-in user can attempt to list trades.
        // The 'get' rule above will be checked for each document, ensuring security.
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isUserActive();
        // Only trade participants or admins can update.
        allow update: if isTradeParticipant(tradeId) || isAdmin();
        allow delete: if false;

        // Subcollections are only accessible to trade participants and admins.
        match /messages/{messageId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
        match /disputes/{disputeId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
        match /feedback/{feedbackId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
    }

    // --- Support Tickets Collection ---
    match /support_tickets/{ticketId} {
        allow create: if isSignedIn();
        allow read, list, update: if isAdmin();
        allow delete: if false;
    }
    
    // --- Globally Readable Platform Configuration ---
    match /payment_methods/{paymentMethodId} {
        allow get, list: if true;
        allow write: if false;
    }
    
    // --- Admin-Only Collections & Configuration ---
    match /crypto_deposit_addresses/{addressId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /admin_logs/{logId} {
        allow read, write: if isAdmin();
    }

    // --- Collection Group Rules for Admin Panel ---
    match /{path=**}/withdrawals/{withdrawalId} {
        allow list, get: if isAdmin();
    }
    match /{path=**}/disputes/{disputeId} {
        allow list, get: if isAdmin();
    }
  }
}
