rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Admin status is determined by the existence of a document in the 'admins' collection.
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTradeParticipant(tradeId) {
      let trade = get(/databases/$(database)/documents/trades/$(tradeId)).data;
      return trade.buyerId == request.auth.uid || trade.sellerId == request.auth.uid;
    }

    // --- Specific Collection Rules ---

    // Admins collection: Admins can create their own role doc upon first login.
    // No one can list all admins. Only an admin can read their own role doc.
    match /admins/{adminId} {
        allow get: if isOwner(adminId) && isAdmin(); // An admin can check their own status
        allow create: if isOwner(adminId); // Allow a user to create their own admin document during login flow
        allow list, update, delete: if false;
    }

    // Users can read/write their own data. Admins have broader read access.
    match /users/{userId} {
      allow get: if true; // Public profiles are readable by anyone
      allow list: if isAdmin(); // Only admins can list all users
      allow create: if isOwner(userId); // A user can create their own profile
      allow update: if isOwner(userId) || isAdmin(); // A user can update their own profile, or an admin can
      allow delete: if isAdmin(); // Only admins can delete users

      // Subcollections are private to the user or admins
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /deposits/{depositId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
       match /withdrawals/{withdrawalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
       match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Ads are public, but only owners/admins can modify.
    match /p2p_ads/{adId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner(resource.data.userId) || isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Trades are only accessible to participants and admins.
    match /trades/{tradeId} {
        allow get, update: if isTradeParticipant(tradeId) || isAdmin();
        allow list: if isAdmin(); // Only admins can list all trades
        allow create: if isSignedIn();
        allow delete: if false; // Trades should not be deleted, only 'cancelled'

        match /messages/{messageId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
        match /disputes/{disputeId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
        match /feedback/{feedbackId} {
            allow read, write: if isTradeParticipant(tradeId) || isAdmin();
        }
    }

    // Support tickets can be created by users, but only read/updated by admins
    match /support_tickets/{ticketId} {
        allow create: if isSignedIn();
        allow read, update: if isAdmin();
        allow delete: if false;
    }
    
    // Globally readable configuration data
    match /payment_methods/{paymentMethodId} {
        allow get, list: if true;
        allow write: if false;
    }

    match /crypto_deposit_addresses/{addressId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Admin-only collections
    match /admin_logs/{logId} {
        allow read, write: if isAdmin();
    }

    // --- Collection Group Rules for Admin Panel ---
    // These are required for admin panel dashboard queries to work.
    match /{path=**}/deposits/{depositId} {
        allow list, get: if isAdmin();
    }
    match /{path=**}/withdrawals/{withdrawalId} {
        allow list, get: if isAdmin();
    }
    match /{path=**}/disputes/{disputeId} {
        allow list, get: if isAdmin();
    }
    
    // Explicitly deny access to any path not defined above.
    // This is the default behavior, but it's good practice to be explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
