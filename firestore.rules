
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isTradeParticipant(tradeData) {
      return isSignedIn() && (tradeData.buyerId == request.auth.uid || tradeData.sellerId == request.auth.uid);
    }
    
    // Validates a wallet creation as part of a user-to-user transfer.
    function isValidTransferCreation(recipientId, walletId) {
      let senderId = request.auth.uid;
      if (senderId == recipientId) { return false; } // No self-transfer

      let senderIsActive = get(/databases/$(database)/documents/users/$(senderId)).data.isBanned == false &&
                           get(/databases/$(database)/documents/users/$(senderId)).data.isOnHold == false;
      let recipientIsActive = get(/databases/$(database)/documents/users/$(recipientId)).data.isBanned == false &&
                              get(/databases/$(database)/documents/users/$(recipientId)).data.isOnHold == false;
      if (!senderIsActive || !recipientIsActive) { return false; }
      
      let data = request.resource.data;
      let allowedKeys = ['balance', 'lockedBalance', 'crypto', 'userId', 'id', 'updatedAt'];
      // On create, ensure balance is positive, locked is 0, and all required fields are set correctly by the sender.
      return data.balance > 0 &&
             data.lockedBalance == 0 &&
             data.userId == recipientId &&
             data.id == walletId &&
             data.crypto == walletId &&
             data.keys().hasOnly(allowedKeys);
    }
    
    // Validates a wallet update as part of a user-to-user transfer.
    function isValidTransferUpdate(recipientId) {
        let senderId = request.auth.uid;
        if (senderId == recipientId) { return false; }

        let senderIsActive = get(/databases/$(database)/documents/users/$(senderId)).data.isBanned == false &&
                           get(/databases/$(database)/documents/users/$(senderId)).data.isOnHold == false;
        let recipientIsActive = get(/databases/$(database)/documents/users/$(recipientId)).data.isBanned == false &&
                              get(/databases/$(database)/documents/users/$(recipientId)).data.isOnHold == false;
        if (!senderIsActive || !recipientIsActive) { return false; }
        
        let incoming = request.resource.data;
        let existing = resource.data;

        // Ensure ONLY balance is increased. All other properties must remain unchanged.
        return incoming.balance > existing.balance &&
               incoming.lockedBalance == existing.lockedBalance &&
               incoming.crypto == existing.crypto &&
               incoming.userId == existing.userId &&
               incoming.id == existing.id;
    }

    // --- Configuration Collections ---
    match /_config/{docId} {
        allow read: if true;
        allow write: if (docId == 'market_data' && isSignedIn()) || isAdmin();
    }
    match /crypto_deposit_addresses/{addressId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    // --- Admin-Specific Collections ---
    match /admins/{adminId} {
        allow get, create: if isOwner(adminId);
        allow list, update, delete: if false;
    }
    match /admin_logs/{logId} {
        allow read, write: if isAdmin();
    }
    match /escrow_ledger/{ledgerId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn() &&
                    request.resource.data.tradeId != null &&
                    get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.buyerId == request.auth.uid &&
                    get(/databases/$(database)/documents/trades/$(request.resource.data.tradeId)).data.status == 'released';
      allow update, delete: if false;
    }

    // --- User-Centric Collections ---
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /wallets/{walletId} {
        // A user must be able to GET another user's wallet to perform a transfer transaction.
        // LIST is restricted to owner only.
        allow get: if isSignedIn() || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        
        // CREATE is allowed for wallet owner, admin, or as part of a valid transfer.
        allow create: if isOwner(userId) || isAdmin() || isValidTransferCreation(userId, walletId);

        // UPDATE is allowed for wallet owner, admin, or as part of a valid transfer.
        allow update: if isOwner(userId) || isAdmin() || isValidTransferUpdate(userId);

        allow delete: if isAdmin();
      }
      match /withdrawals/{withdrawalId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
       match /sessions/{sessionId} {
        allow read, list, create: if isOwner(userId) || isAdmin();
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Top-Level Data Collections ---
    match /deposits/{depositId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'awaiting_confirmation' &&
        request.resource.data.txId != null &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.crypto == resource.data.crypto &&
        request.resource.data.chain == resource.data.chain
      );
      allow delete: if isAdmin();
    }

    match /p2p_ads/{adId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if (isSignedIn() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    match /trades/{tradeId} {
        allow get: if isTradeParticipant(resource.data) || isAdmin();
        allow list: if isSignedIn();
        // Allow trade creation only for the buyer.
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.buyerId;
        allow update: if isTradeParticipant(resource.data) || isAdmin();
        allow delete: if false;

        match /messages/{messageId} {
            allow read, write: if isTradeParticipant(get(/databases/$(database)/documents/trades/$(tradeId)).data) || isAdmin();
        }
        match /disputes/{disputeId} {
            allow read, write: if isTradeParticipant(get(/databases/$(database)/documents/trades/$(tradeId)).data) || isAdmin();
        }
        match /feedback/{feedbackId} {
            allow read, write: if isTradeParticipant(get(/databases/$(database)/documents/trades/$(tradeId)).data) || isAdmin();
        }
    }

    match /transfers/{transferId} {
      allow get: if isSignedIn() && (isOwner(resource.data.senderId) || isOwner(resource.data.recipientId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(request.resource.data.senderId);
      allow update, delete: if false;
    }

    match /support_tickets/{ticketId} {
        allow create: if isSignedIn() && isOwner(request.resource.data.userId);
        allow read, list, update: if isAdmin();
        allow delete: if false;
    }
    
    // --- Collection Group Rules for Admin Panel ---
    match /{path=**}/withdrawals/{withdrawalId} {
        allow list, get: if isAdmin();
    }
    match /{path=**}/disputes/{disputeId} {
        allow list: if isAdmin();
        allow get: if isTradeParticipant(get(/databases/$(database)/documents/trades/$(resource.data.tradeId)).data) || isAdmin();
    }

    // --- Global Catch-All Rule ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
