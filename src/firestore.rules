
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       Helper Functions
    ============================== */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    function isTradeParticipant(tradeData) {
      return isSignedIn() &&
        (tradeData.buyerId == request.auth.uid ||
         tradeData.sellerId == request.auth.uid);
    }

    /* ==============================
       USERS
    ============================== */

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    /* ==============================
       P2P ADS
    ============================== */

    match /p2p_ads/{adId} {

      // Public can view ads
      allow get, list: if true;

      // Create ad → must be logged in and owner
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.minAmount > 0 &&
                    request.resource.data.maxAmount >= request.resource.data.minAmount;

      // Update/Delete → only owner or admin
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    /* ==============================
       TRADES
    ============================== */

    match /trades/{tradeId} {

      // Only buyer or seller can read
      allow get: if isTradeParticipant(resource.data) || isAdmin();
      allow list: if isSignedIn();

      // Only buyer can create trade
      allow create: if isSignedIn() &&
                    request.resource.data.buyerId == request.auth.uid;

      // Only trade participants or admin can update
      allow update: if isTradeParticipant(resource.data) || isAdmin();

      allow delete: if false;

      // Subcollections
      match /messages/{messageId} {
        allow read, write: if isTradeParticipant(
          get(/databases/$(database)/documents/trades/$(tradeId)).data
        ) || isAdmin();
      }

      match /disputes/{disputeId} {
        allow read, write: if isTradeParticipant(
          get(/databases/$(database)/documents/trades/$(tradeId)).data
        ) || isAdmin();
      }

      match /feedback/{feedbackId} {
        allow read, write: if isTradeParticipant(
          get(/databases/$(database)/documents/trades/$(tradeId)).data
        ) || isAdmin();
      }
    }
    
    /* ==============================
       CONFIGURATION
    ============================== */
    match /_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==============================
       ADMIN COLLECTION
    ============================== */

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    /* ==============================
       GLOBAL BLOCK (SECURITY)
    ============================== */

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
